# Optional. Users can enter their own HTTPS homeserver on the sign-in screen.
VITE_MATRIX_HOMESERVER=https://matrix.example.org

# Backend Lumi: connect a PRIVATE Vercel Blob store to the Vercel project.
# BLOB_READ_WRITE_TOKEN is injected by the integration; never expose it with VITE_.
# Recommended: coturn REST credentials (short-lived, generated server-side).
# LUMI_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp
# LUMI_TURN_SECRET=configure-only-in-vercel-environment-settings
# Alternative for a managed TURN provider: JSON RTCIceServer[] in a server-only env.
# LUMI_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"},{"urls":"turns:turn.example.org:443","username":"provider-user","credential":"provider-password"}]
